{
  "name": "rameng-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop shell for RAM Engineering CRM",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "il.co.r-eng.ramengcrm",
    "productName": "ראם הנדסה CRM",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "RAMeng-CRM-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ראם הנדסה CRM",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
