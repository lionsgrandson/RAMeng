{
  "name": "rameng-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "mobile:init": "npx cap add android",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:apk": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "deploy:cloudflare": "npm run build && npm --prefix worker install && npm --prefix worker run deploy"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@e965/xlsx": "^0.20.3",
    "@supabase/supabase-js": "^2.90.0",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
