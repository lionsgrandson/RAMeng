# Production deployment serves the frontend and /api from the same Cloudflare Worker,
# so these can remain empty in production.
# For local Vite development, run the Worker on :8787 and use:
VITE_API_BASE=http://localhost:8787

# Optional direct Supabase fallback for frontend-only local development.
# Normally the Worker provides these through /api/public-config.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=
