# Production serves the frontend and /api from the same Cloudflare Worker.
# The deployed Worker serves both the frontend and API.
VITE_API_BASE=https://rameng-crm.rameng-crm-worker.workers.dev

# Direct Supabase fallback for frontend-only local development.
# Use only the public Project URL and publishable/anon key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=

# Local developer account(s), comma separated.
# Production developer identity is configured in the CRM first-run setup.
VITE_DEVELOPER_EMAILS=

# NEVER put SUPABASE_SECRET_KEY here.
# For local Worker invitation testing, copy worker/.dev.vars.example to
# worker/.dev.vars and put the server-only secret there.
