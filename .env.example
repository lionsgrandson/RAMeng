# Production deployment serves the frontend and /api from the same Cloudflare Worker.
# For local Vite development with the Worker, use:
VITE_API_BASE=http://localhost:8787

# Direct Supabase fallback for frontend-only local development.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=

# Local developer account(s), comma separated. This only controls developer-only UI locally.
VITE_DEVELOPER_EMAILS=
